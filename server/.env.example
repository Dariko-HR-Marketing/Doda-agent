# Nusxa oling: cp .env.example .env   (.env GitHub'ga YUKLANMAYDI)
APP_ORIGIN=https://doda.tajriba24.uz
PUBLIC_API_URL=https://doda-api.tajriba24.uz
TRUST_PROXY=true

# Pochta (Gmail SMTP: App Password ishlatiladi, oddiy parol emas)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DODA <sizning-pochtangiz@gmail.com>"

# Google bilan kirish (Google Cloud > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI provayderlar. Kaliti bor provayder yoqiladi, kalitsizi o'zi o'chiq turadi.
# Kalitlarni qo'lda yozmang: bash deploy/set-key.sh anthropic|openai|gemini  (ekranda ko'rinmaydi)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Ustuvorlik (chapdan o'ngga). Biri ishlamasa keyingisiga o'tadi
LLM_PRIORITY=gemini,anthropic,openai

# Rozilik matni versiyasi (oferta o'zgarganda oshiring)
LEGAL_VERSION=2026-11-draft
