# Set these only on the server; never commit actual values.
DODA_PUBLIC_ORIGIN=https://doda.tajriba24.uz
DODA_SESSION_SECRET=replace-with-at-least-32-random-characters
DODA_OWNER_EMAIL=owner@example.com
DODA_OWNER_NAME=Kapitan
DODA_ORG_NAME=DODA tashkiloti
# SMTP credentials remain only on the server. Use TLS or SSL.
DODA_SMTP_HOST=smtp.example.com
DODA_SMTP_PORT=587
DODA_SMTP_SECURITY=starttls
DODA_SMTP_FROM=doda@example.com
DODA_SMTP_USER=your-smtp-account
DODA_SMTP_PASSWORD=server-side-smtp-secret
# Priority order. Leave one provider in the list to disable fallback.
DODA_AI_ORDER=openai,gemini,claude
DODA_MODEL=your-available-openai-model
OPENAI_API_KEY=server-side-openai-key
DODA_GEMINI_MODEL=your-available-gemini-model
GEMINI_API_KEY=server-side-gemini-key
DODA_CLAUDE_MODEL=your-available-claude-model
ANTHROPIC_API_KEY=server-side-anthropic-key
# Optional if the Anthropic API key is not scoped to one workspace.
# ANTHROPIC_WORKSPACE_ID=wrkspc_your_workspace
